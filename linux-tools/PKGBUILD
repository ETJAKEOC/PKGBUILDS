pkgbase=linux-tools
pkgname=('bootconfig' 'bpf' 'cpupower' 'linux-tools-meta' 'tmon' 'turbostat' 'usbip' 'x86_energy_perf_policy' 'intel-speed-select')
pkgver=7.0.3
pkgrel=420
license=('GPL-2.0-only')
arch=('x86_64')
url='https://www.kernel.org'
options=('!strip')
makedepends=('git' 'asciidoc' 'xmlto' 'perl' 'python' 'python-setuptools' 'slang' 'elfutils' 'libunwind' 'numactl' 'audit' 'zstd'
  'libtraceevent' 'openssl' 'libpfm' 'pciutils' 'glib2' 'sysfsutils' 'udev' 'ncurses' 'readline' 'zlib' 'libelf' 'libcap' 'python-docutils' 'libcap' 'libnl')
groups=("$pkgbase")
source=("https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${pkgver}.tar.xz"
  'cpupower.systemd' 'cpupower.default' 'cpupower.install' 'cpupower.service' 'usbipd.service' 'hv_kvp_daemon.service' 'hv_vss_daemon.service')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
options=('!debug' '!docs' '!emptydirs' '!staticlibs' 'ccache' 'buildflags' 'lto' 'makeflags' 'strip')

prepare() {
  ln -sf linux-${pkgver} linux
  cd linux
  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.xz}"
    [[ $src = *.patch || $src = patch-* ]] || continue
    echo ":: Applying patch $src"
    patch -p1 -N -i "$srcdir/$src"
  done
  cat >tools/perf/util/PERF-VERSION-GEN <<EOF
echo '#define PERF_VERSION "$pkgver-$pkgrel"' > "\${1:-.}"/PERF-VERSION-FILE
EOF
}

build() {
  source /etc/environment.kern

  echo ':: cpupower'
  pushd linux/tools/power/cpupower
  LLVM=1 LLVM_IAS=1 make VERSION=$pkgver-$pkgrel
  popd

  echo ':: x86_energy_perf_policy'
  pushd linux/tools/power/x86/x86_energy_perf_policy
  LLVM=1 LLVM_IAS=1 make
  popd

  echo ':: tmon'
  pushd linux/tools/thermal/tmon
  LLVM=1 LLVM_IAS=1 make
  popd

  echo ':: turbostat'
  pushd linux/tools/power/x86/turbostat
  LLVM=1 LLVM_IAS=1 make
  popd

  echo ':: hv'
  pushd linux/tools/hv
  CFLAGS+=' -DKVP_SCRIPTS_PATH=\"/usr/lib/hypervkvpd/\"' LLVM=1 LLVM_IAS=1 make
  popd

  echo ':: bpf'
  pushd linux/tools/bpf
  LLVM=1 LLVM_IAS=1 make -C bpftool all doc
  popd

  echo ':: bootconfig'
  pushd linux/tools/bootconfig
  LLVM=1 LLVM_IAS=1 make
  popd

  echo ':: intel-speed-select'
  pushd linux/tools/power/x86/intel-speed-select
  LLVM=1 LLVM_IAS=1 make
  popd

  echo ':: usbip'
  pushd linux/tools/usb/usbip
  sed -i 's,-Wall -Werror -Wextra,-fcommon,' configure.ac
  ./autogen.sh
  ./configure --prefix=/usr --sbindir=/usr/bin
  LLVM=1 LLVM_IAS=1 make
  popd
}

package_linux-tools-meta() {
  pkgdesc='Linux kernel tools meta package'
  groups=()
  depends=(
    'bootconfig'
    'bpf'
    'cpupower'
    'hyperv'
    'tmon'
    'turbostat'
    'usbip'
    'x86_energy_perf_policy'
    'intel-speed-select'
  )
  conflicts=(
    'acpidump'
  )
}

package_cpupower() {
  pkgdesc='Linux kernel tool to examine and tune power saving related features of your processor'
  backup=('etc/default/cpupower')
  depends=('glibc' 'bash' 'pciutils')
  conflicts=('cpufrequtils')
  replaces=('cpufrequtils')
  install=cpupower.install

  pushd linux/tools/power/cpupower
  LLVM=1 LLVM_IAS=1 make \
    DESTDIR="$pkgdir" \
    sbindir='/usr/bin' \
    libdir='/usr/lib' \
    mandir='/usr/share/man' \
    docdir='/usr/share/doc/cpupower' \
    install install-man
  popd
  install -Dm 644 "${srcdir}/${pkgname}.default" "${pkgdir}/etc/default/${pkgname}"
  install -Dm 644 "${srcdir}/${pkgname}.service" "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm 755 "${srcdir}/${pkgname}.systemd" "${pkgdir}/usr/lib/systemd/scripts/${pkgname}"
}

package_x86_energy_perf_policy() {
  pkgdesc='Read or write MSR_IA32_ENERGY_PERF_BIAS'
  depends=('glibc')

  cd linux/tools/power/x86/x86_energy_perf_policy
  install -Dm 755 x86_energy_perf_policy "$pkgdir/usr/bin/x86_energy_perf_policy"
  install -Dm 644 x86_energy_perf_policy.8 "$pkgdir/usr/share/man/man8/x86_energy_perf_policy.8"
}

package_usbip() {
  pkgdesc='An USB device sharing system over IP network'
  depends=('glibc' 'glib2' 'sysfsutils' 'systemd-libs')

  pushd linux/tools/usb/usbip
  LLVM=1 LLVM_IAS=1 make install DESTDIR="$pkgdir"
  popd
  install -Dm 644 /dev/null "$pkgdir/usr/lib/modules-load.d/$pkgname.conf"
  printf 'usbip-core\nusbip-host\n' >"$pkgdir/usr/lib/modules-load.d/$pkgname.conf"
  install -Dm 644 usbipd.service "$pkgdir/usr/lib/systemd/system/usbipd.service"
}

package_tmon() {
  pkgdesc='Monitoring and Testing Tool for Linux kernel thermal subsystem'
  depends=('glibc' 'ncurses')

  cd linux/tools/thermal/tmon
  LLVM=1 LLVM_IAS=1 make install INSTALL_ROOT="$pkgdir"
}

package_turbostat() {
  pkgdesc='Report processor frequency and idle statistics'
  depends=('glibc' 'libcap')

  cd linux/tools/power/x86/turbostat
  LLVM=1 LLVM_IAS=1 make install DESTDIR="$pkgdir"
}

package_hyperv() {
  pkgdesc='Hyper-V tools'
  depends=('glibc')

  cd linux/tools/hv
  LLVM=1 LLVM_IAS=1 make install DESTDIR="$pkgdir" sbindir=/usr/bin libexecdir=/usr/lib
  for _p in hv_kvp_daemon hv_vss_daemon; do
    install -Dm644 "$srcdir/$_p.service" "$pkgdir/usr/lib/systemd/system/$_p.service"
  done
}

package_bpf() {
  pkgdesc='BPF tools'
  depends=('glibc' 'readline' 'zlib' 'libelf' 'libcap' 'zstd' 'binutils' 'libsframe.so' 'llvm-libs-git')

  mkdir -p "$pkgdir"/usr/bin
  cd linux/tools/bpf
  LLVM=1 LLVM_IAS=1 make install prefix=/usr DESTDIR="$pkgdir"
  cp -a "$srcdir"/linux/tools/bpf/bpftool/bpftool "$pkgdir"/usr/bin/bpftool
  mv "$pkgdir"/usr/sbin/bpftool "$pkgdir"/usr/bin/bpftool
  rmdir "$pkgdir"/usr/sbin
  LLVM=1 LLVM_IAS=1 make -C bpftool doc-install prefix=/usr/share DESTDIR="$pkgdir"
}

package_bootconfig() {
  pkgdesc='Apply, delete or show boot config to initrd'
  depends=('glibc')

  cd linux/tools/bootconfig
  install -dm755 "$pkgdir/usr/bin"
  LLVM=1 LLVM_IAS=1 make install DESTDIR="$pkgdir"
}

package_intel-speed-select() {
  pkgdesc='Intel Speed Select'
  depends=('libnl')

  cd linux/tools/power/x86/intel-speed-select
  LLVM=1 LLVM_IAS=1 make install DESTDIR="$pkgdir"
}
