		glibc
		libvlc
		zlib
	)

	mv "${srcdir}/vlc-plugins-base"/* "${pkgdir}"
}

package_vlc-plugins-extra() {
	pkgdesc+=" - extended local media plugins"

	depends=(
		glibc
