	mv "${srcdir}/vlc-plugins-extra"/* "${pkgdir}"
}

package_vlc-plugins-video-output() {
	pkgdesc+=" - AMD-focused video output plugins"

	depends=(
		gcc-libs
		glibc
		libglvnd
		libva
		libvlc
		libx11
		libxcb
		wayland
		xcb-util-keysyms
	)

	optdepends=(
		'libva-mesa-driver: Mesa VA-API acceleration'
	)

	provides=(
		libvlc_vdpau.so
		libvlc_xcb_events.so
	)

	mv "${srcdir}/vlc-plugins-video-output"/* "${pkgdir}"
}

