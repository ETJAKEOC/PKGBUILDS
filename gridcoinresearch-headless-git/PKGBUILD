pkgname=(gridcoinresearch-headless-git)
pkgver=5.5.0
pkgrel=1
pkgdesc="A cryptocurrency that rewards users for participating on the BOINC network"
makedepends=('git' 'boost' 'db')
depends=('boost-libs' 'db' 'miniupnpc')
arch=('x86_64')
url="https://gridcoin.us"
license=('custom:gridcoin')
_sourcename="Gridcoin-Research"
source=("git+https://github.com/gridcoin/Gridcoin-Research.git#branch=master"
	"linux.mk.patch" "default.mk.patch" "packages.md.patch")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')
options=('!ccache' '!lto' '!buildflags' '!makeflags')

prepare() {
  cd "${srcdir}/${_sourcename}"
  patch -p1 < "${srcdir}/linux.mk.patch"
  patch -p1 < "${srcdir}/default.mk.patch"
  patch -p1 < "${srcdir}/packages.md.patch"
}

build() {
_flags=(
        -G Ninja
        -Wno-dev
        -Wno-deprecated
        -Wno-error=dev
        -Wno-error=deprecated

	-B "${srcdir}/build"
	-S "${srcdir}/${_sourcename}"
        -DCMAKE_BUILD_TYPE=Release
        -DCMAKE_INSTALL_PREFIX=/usr
        -DCMAKE_INSTALL_LIBDIR=lib
        -DCMAKE_INSTALL_RPATH="/usr/lib"

	-DCMAKE_C_COMPILER="/bin/clang"
	-DCMAKE_CXX_COMPILER="/bin/clang++"
	-DCMAKE_LINKER="/bin/lld"
        -DCMAKE_C_FLAGS="$CFLAGS"
	-DCMAKE_CXX_FLAGS="$CXXFLAGS"
	-DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS"
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF

	-DSTATIC_LIBS=OFF
	-DENABLE_DOCS=OFF
	-DENABLE_GUI=OFF
	-DENABLE_PIE=ON
	-DENABLE_TESTS=OFF
	-DENABLE_UPNP=ON
	-DDEFAULT_UPNP=ON
)

  export CC=/bin/clang
  export CPP=/bin/clang-cpp
  export CXX=/bin/clang++
  export LD=/bin/lld
  export CC_LD=/bin/lld
  export CXX_LD=/bin/lld
  export AR=/bin/llvm-ar
  export NM=/bin/llvm-nm
  export STRIP=/bin/llvm-strip
  export OBJCOPY=/bin/llvm-objcopy
  export OBJDUMP=/bin/llvm-objdump
  export READELF=/bin/llvm-readelf
  export RANLIB=/bin/llvm-ranlib

  export CARCH="x86_64"
  export CHOST="$CARCH-pc-linux-gnu"
  export HOST="$CHOST"

  export CFLAGS="-march=bdver2 -mtune=bdver2 -pipe -O3 -g0 -Wno-error -fPIE -fPIC -funroll-loops -rtlib=compiler-rt -fuse-ld=lld"
  export CPPFLAGS="$CFLAGS"
  export CXXFLAGS="$CFLAGS -unwindlib=libunwind"
  export LDFLAGS="-O3 -pipe -rtlib=compiler-rt -unwindlib=libunwind -shared-libgcc -fuse-ld=lld -Wl,--as-needed"
  export RUSTFLAGS="-C opt-level=3 -C target-cpu=bdver2 -C codegen-units=1 -C linker=clang -C panic=abort -C debuginfo=0 -C strip=debuginfo"

  cmake "${_flags[@]}"

  cmake --build "${srcdir}/build" --parallel
}

package() {
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"
}
