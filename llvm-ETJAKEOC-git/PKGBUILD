package_mesa() {
#	local mesa_ver
#	mesa_ver=$(_mesa_pkgver)
        depends=('llvm' 'llvm-libs' 'clang')
	provides=("mesa" "mesa-libgl" "opengl-driver")
#	provides=("mesa=$mesa_ver" "mesa-libgl=$mesa_ver" "opengl-driver")
	conflicts=('mesa')

        pkg_prep

        DESTDIR="$pkgdir" ninja -j$(nproc) -C _build-mesa install
        ln -s usr/lib/libGLX_mesa.so.0 "$pkgdir/usr/lib/libGLX_indirect.so.0"
}

package_lib32-mesa() {
#	local mesa_ver
#	mesa_ver=$(_mesa_pkgver)
        depends=('mesa' 'lib32-llvm-libs')
	provides=("lib32-mesa" "lib32-mesa-libgl" "lib32-opengl-driver")
#	provides=("lib32-mesa=$mesa_ver" "lib32-mesa-libgl=$mesa_ver" "lib32-opengl-driver")
	conflicts=('lib32-mesa')

        pkg_prep

        DESTDIR="$pkgdir" ninja -j$(nproc) -C _build-mesa32 install
        ln -s usr/lib32/libGLX_mesa.so.0 "$pkgdir/usr/lib32/libGLX_indirect.so.0"
        rm -rf \
                "$pkgdir/usr/include" \
                "$pkgdir/usr/share/drirc.d" \
                "$pkgdir/usr/share/glvnd" \
                "$pkgdir/usr/share/vulkan/explicit_layer.d" \
                "$pkgdir/usr/share/vulkan/implicit_layer.d" \
                "$pkgdir/usr/bin"
        rm -f "$pkgdir/usr/share/vulkan/icd.d/"*.x86_64.json
}
