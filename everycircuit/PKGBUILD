# Maintainer: ETJAKEOC <ETJAKEOC@gmail.com>
pkgname=everycircuit
pkgver=1.0.0
pkgrel=1
pkgdesc="Native-like EveryCircuit wrapper using Electron"
arch=('x86_64')
url="https://everycircuit.com/"
license=('GPL')
depends=('electron')
makedepends=('asar')
source=(main.js package.json $pkgname.sh $pkgname.desktop $pkgname.png)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
options=('!emptydirs')

prepare() {
    cd "${srcdir}"
    rm main.js package.json "${pkgname}".{sh,desktop,png}
    cp -a ../main.js ./
    cp -a ../package.json ./
    cp -a ../"${pkgname}.sh" ./
    cp -a ../"${pkgname}.desktop" ./
    cp -a ../"${pkgname}.png" ./
    source /usr/share/nvm/init-nvm.sh || [[ $? != 1 ]]
    nvm install 24
    nvm use 24
}

build() {
    cd "${srcdir}"
    asar pack . "${srcdir}/app.asar"
}

package() {
    install -Dm644 "${srcdir}/app.asar" "${pkgdir}/opt/$pkgname/app.asar"
    install -Dm755 "${srcdir}/$pkgname.sh" "${pkgdir}/usr/bin/$pkgname"
    install -Dm644 "${srcdir}/$pkgname.desktop" "${pkgdir}/usr/share/applications/$pkgname.desktop"
    install -Dm644 "${srcdir}/$pkgname.png" "${pkgdir}/usr/share/pixmaps/$pkgname.png"
    chmod +x "${pkgdir}/usr/bin/$pkgname"
}
