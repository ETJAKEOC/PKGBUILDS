# Maintainer: ETJAKEOC <ETJAKEOC@gmail.com>
pkgname=unityhub-appimage
pkgver=3.7.0
pkgrel=1
pkgdesc="Unity Hub as an AppImage - manage your Unity projects and installs"
arch=('x86_64')
url="https://unity3d.com/get-unity/download"
license=('custom')
options=(!strip)
source=("UnityHub.AppImage::https://public-cdn.cloud.unity3d.com/hub/prod/UnityHub.AppImage")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}"
  chmod +x "$srcdir/UnityHub.AppImage"
}

build() {
  cd "${srcdir}"
  ./UnityHub.AppImage --appimage-extract
}

package() {
  install -d "${pkgdir}/opt/unityhub"
  cp -r "${srcdir}/squashfs-root/." "${pkgdir}/opt/unityhub/"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/unityhub/AppRun "${pkgdir}/usr/bin/unityhub"
  install -Dm644 "${srcdir}/squashfs-root/unityhub.desktop" "${pkgdir}/usr/share/applications/unityhub.desktop"
  cp -r "${pkgdir}/opt/unityhub/usr/share/icons" "${pkgdir}/usr/share/"
}
