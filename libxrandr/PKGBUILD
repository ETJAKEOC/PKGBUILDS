pkgname=('libxrandr' 'lib32-libxrandr')
pkgver=1.5.5
pkgrel=1
pkgdesc="X11 RandR extension library"
arch=('x86_64')
license=('HPND-sell-variant')
url="https://gitlab.freedesktop.org/xorg/lib/libxrandr"
depends=('libxext' 'libxrender' 'libx11' 'glibc')
makedepends=('xorg-util-macros' 'xorgproto')
source=(git+${url}.git)
sha512sums=('SKIP' 'SKIP')

build() {
  cp -a "${srcdir}/libxrandr" "${srcdir}/libxrandr32"
  cd "${srcdir}/libxrandr"

  ./autogen.sh --prefix=/usr --sysconfdir=/etc
  make

  cd "${srcdir}/libxrandr32"
  make distclean || true

  export CC="clang -m32"
  export CXX="clang++ -m32"
  export LD="ld.lld -m32"
  export CFLAGS="-m32"
  export CXXFLAGS="-m32"
  export LDFLAGS="-m32"
  export PKG_CONFIG="i686-pc-linux-gnu-pkg-config"

  ./autogen.sh -host=i686-pc-linux-gnu --prefix=/usr --sysconfdir=/etc --libdir=/usr/lib32
  make
}

package_libxrandr() {
  pkgname='libxrandr'
  cd "${srcdir}/libxrandr"
  make DESTDIR="${pkgdir}" install
}

package_lib32-libxrandr() {
  pkgname='lib32-libxrandr'
  cd "${srcdir}/libxrandr32"
  make DESTDIR="${pkgdir}" install
  rm -rf "${pkgdir}"/usr/{include,share,bin}
}
