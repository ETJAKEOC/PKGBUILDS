pkgname=libplacebo
pkgver=7.360.0.55.g464d6eab
pkgrel=1
pkgdesc='Reusable library for GPU-accelerated video/image rendering primitives'
url='https://github.com/haasn/libplacebo'
arch=('x86_64')
license=('LGPL-2.1-or-later')
depends=('vulkan-icd-loader' 'glslang' 'lcms2' 'shaderc' 'glibc' 'gcc-libs' 'libunwind' 'libdovi' 'xxhash')
makedepends=('meson' 'ninja' 'vulkan-headers' 'glad' 'nuklear' 'python' 'python-setuptools' 'python-mako' 'python-markupsafe' 'python-jinja' 'libglvnd')
provides=('libplacebo.so')
source=(git+https://code.videolan.org/videolan/libplacebo.git)
sha512sums=('SKIP')
options=('!debug' '!docs' '!emptydirs' '!staticlibs' 'ccache' 'buildflags' 'lto' 'makeflags' 'strip')

pkgver() {
    cd "${srcdir}/${pkgname}"
    git describe --tags --match 'v[0-9]*' --always --long | sed -e 's/^v//' -e 's/-/./g'
}

prepare() {
  cd "${srcdir}/${pkgname}"
  git submodule update --init --recursive
}

build() {
  cd "${srcdir}/${pkgname}"

  export CPPFLAGS="-march=znver2 -mtune=znver2 -pipe -O3 -g0 -Wno-error"
  export CFLAGS="$CPPFLAGS -flto=thin -fcommon"
  export CXXFLAGS="$CFLAGS -I/usr/include/glslang"
  export LDFLAGS="-flto=thin -fuse-ld=lld -O3 -Wl,--allow-shlib-undefined"
  export LLVM_VERSION="23"

  meson "${srcdir}/build" \
    -Dtests=true \
    --reconfigure \
    --optimization  3 \
    --auto-features enabled \
    -D prefix=/usr \
    -D libdir=lib \
    -D b_pie=true \
    -D b_staticpic=true \
    -D b_lto=true \
    -D python.bytecompile=2 \
    -D backend=ninja \
    -D b_colorout=always \
    -D c_args="$CFLAGS" \
    -D c_link_args="$LDFLAGS" \
    -D cpp_args="$CPPFLAGS" \
    -D cpp_link_args="$LDFLAGS" \
    -D vulkan=enabled \
    -D glslang=enabled \
    -D shaderc=enabled \
    -D lcms=enabled \
    -D d3d11=disabled \
    -D libdovi=enabled \
    -D tests=false \
    -D demos=false
  ninja -C "${srcdir}/build"
}

package() {
  cd "${pkgname}"
  DESTDIR="$pkgdir" ninja install -C "${srcdir}/build"
}
